APP_ENV=development
APP_SECRET=change-me-before-any-non-local-use
API_PORT=8000
WEB_PORT=5173

MONGO_URI=mongodb://localhost:27017
MONGO_DB=zhengheng
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9201
OPENSEARCH_INDEX=policy_chunks
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-local-dev-password
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=
MINIO_ROOT_USER=replace-with-local-dev-user
MINIO_ROOT_PASSWORD=replace-with-local-dev-password

LLM_MODE=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# V1.1 semantic runtime. Keep legacy for the frozen V1.0 path; Pi is internal only.
AGENT_RUNTIME_BACKEND=legacy
AGENT_RUNTIME_FALLBACK=none
PI_RUNTIME_BASE_URL=http://pi-runtime:8090
PI_RUNTIME_TIMEOUT_MS=20000
PI_RUNTIME_CONNECT_TIMEOUT_MS=3000
INTERNAL_SERVICE_TOKEN=replace-with-a-long-local-secret
SERVICE_ROLE=orchestrator
DEPT_ID=
AGENT_ID=orchestrator
MULTI_AGENT_MAX_DEPARTMENTS=3
ORCHESTRATOR_MAX_PARALLEL=4
DEPARTMENT_AGENT_TIMEOUT_MS=12000
# Optional static JSON array supplied by Helm/env; otherwise tax/hrss/housing defaults are used.
DEPARTMENT_AGENTS_JSON=
MULTI_AGENT_ENABLED=false
AGENT_EXECUTION_MODE=single
DEPARTMENT_AGENT_TAX_URL=http://localhost:8101
DEPARTMENT_AGENT_HRSS_URL=http://localhost:8102
DEPARTMENT_AGENT_HOUSING_URL=http://localhost:8103

EMBEDDING_MODE=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

BM25_TOP_K=40
DENSE_TOP_K=40
RRF_K=60
FUSED_TOP_K=60
RERANK_TOP_N=30
FINAL_CONTEXT_TOP_K=8

MAX_UPLOAD_MB=20
MAX_QUERY_CHARS=2000
SESSION_TTL_SECONDS=7200
MEMORY_TOKEN_BUDGET=2400

DEFAULT_GRAY_PERCENT=10
EXPERIMENT_MIN_ARM_N=50
ROLLBACK_ABS_DROP=0.05
PROMOTE_ABS_GAIN=0.03
STAT_P_VALUE=0.05

DATASET_CACHE_DIR=/app/data/cache
